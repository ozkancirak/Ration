<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Ration.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Title="Ayarlar — Ration">

    <ScrollViewer x:Name="SettingsScrollViewer"
                  Background="Transparent"
                  MinWidth="440"
                  MinHeight="420"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Center">
        <StackPanel x:Name="SettingsContent"
                    Spacing="8"
                    MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Padding="24,0,24,24">

            <!-- Özel Başlık Çubuğu (Drag Region) -->
            <Grid x:Name="AppTitleBar"
                  Height="36">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE713;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Ration"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            </Grid>

            <TextBlock Text="Ayarlar"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,8,0,0" />

            <!-- İçerik tek panel içinde; kaydırma bunun dışındaki ScrollViewer'a aittir. -->

            <!-- Bölüm: Sağlayıcılar -->
            <TextBlock Text="Sağlayıcılar"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,16,0,0" />

            <controls:SettingsExpander x:Name="ClaudeProviderExpander"
                                       Header="Claude Code"
                                       Description="Yerel kimlik bilgileri ve kullanım kotası takibi"
                                       IsExpanded="true">
                <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="Sağlayıcı Durumu"
                                               Description="~/.claude/.credentials.json oturumu">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <InfoBadge x:Name="ClaudeProviderBadge"
                                           Style="{StaticResource SuccessDotInfoBadgeStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="ClaudeProviderStatus"
                                            Text="Denetleniyor…"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Maliyet Taraması"
                                               Description="~/.claude/projects/ altındaki JSONL oturum loglarını tara">
                            <!-- Kapalı gibi duran pasif toggle yerine gerçek durum: tarama
                                 ayarsız her zaman çalışır, para tutarı pricing.json ister. -->
                            <StackPanel Spacing="2" MinWidth="180">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <InfoBadge x:Name="ClaudeCostBadge"
                                               Style="{StaticResource SuccessDotInfoBadgeStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="ClaudeCostStatus"
                                               Text="Açık"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="ClaudeCostReason"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander x:Name="CodexProviderExpander"
                                       Header="Codex"
                                       Description="Yerel kimlik bilgileri ve kullanım kotası takibi"
                                       IsExpanded="true">
                <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="Sağlayıcı Durumu"
                                               Description="~/.codex/auth.json oturumu">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <InfoBadge x:Name="CodexProviderBadge"
                                           Style="{StaticResource SuccessDotInfoBadgeStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="CodexProviderStatus"
                                            Text="Denetleniyor…"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Maliyet Taraması"
                                               Description="~/.codex/sessions/ altındaki JSONL oturum loglarını tara">
                            <StackPanel Spacing="2" MinWidth="180">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <InfoBadge x:Name="CodexCostBadge"
                                               Style="{StaticResource SuccessDotInfoBadgeStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="CodexCostStatus"
                                               Text="Açık"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="CodexCostReason"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- Bölüm: Genel Tercihler -->
            <TextBlock Text="Genel Tercihler"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,16,0,0" />

                <controls:SettingsCard Header="Yenileme Sıklığı"
                                        Description="Kotaların arka planda otomatik sorgulanma aralığı">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72C;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="RefreshIntervalSelection" MinWidth="140">
                        <ComboBoxItem Content="5 dakika" Tag="5" />
                        <ComboBoxItem Content="15 dakika" Tag="15" />
                        <ComboBoxItem Content="30 dakika" Tag="30" />
                        <ComboBoxItem Content="1 saat" Tag="60" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Header="Tema"
                                       Description="Ration'ın renk teması">
                    <ComboBox x:Name="ThemeSelection"
                              MinWidth="140"
                              AutomationProperties.Name="Tema">
                        <ComboBoxItem Content="Sistem" Tag="system" />
                        <ComboBoxItem Content="Açık" Tag="light" />
                        <ComboBoxItem Content="Koyu" Tag="dark" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Header="Tepside göster"
                                       Description="Tepsi ikonunda hangi sağlayıcının kotası gösterilsin">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE950;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="TrayProviderSelection"
                              SelectedIndex="0"
                              MinWidth="160"
                              AutomationProperties.Name="Tepside göster">
                        <ComboBoxItem Content="Otomatik" Tag="auto" />
                        <ComboBoxItem Content="Claude" Tag="claude" />
                        <ComboBoxItem Content="Codex" Tag="codex" />
                        <ComboBoxItem Content="Antigravity" Tag="antigravity" />
                        <ComboBoxItem Content="OpenCode" Tag="opencode" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Header="Windows ile Başlat"
                                       Description="Oturum açıldığında Ration'ı arka planda otomatik çalıştır">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="StartupToggle"
                                  OnContent="Açık"
                                  OffContent="Kapalı" />
                </controls:SettingsCard>

                <controls:SettingsCard x:Name="UpdatesCard">
                    <controls:SettingsCard.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Güncellemeler"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="UpdateStatusText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </controls:SettingsCard.Header>
                    <Button x:Name="CheckUpdatesButton"
                            Content="Denetle"
                            HorizontalAlignment="Right" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="Tanılama"
                                       Description="Sorun giderme için Ration günlüğünü aç">
                    <Button x:Name="OpenLogButton"
                            Content="Günlüğü aç"
                            HorizontalAlignment="Left" />
                </controls:SettingsCard>

            <!-- Bölüm: Hakkında -->
            <TextBlock Text="Hakkında"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,16,0,0" />

            <controls:SettingsCard Description="Windows 11 Native System Tray Quota Tracker">
                    <controls:SettingsCard.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Ration"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="VersionText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </controls:SettingsCard.Header>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Sağlayıcı işaretleri: Simple Icons (CC0), lobe-icons (MIT), OpenAI resmi SVG."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
            </controls:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Window>
