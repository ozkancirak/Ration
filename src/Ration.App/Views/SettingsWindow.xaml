<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Ration.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Ration.App"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Title="Ayarlar — Ration">

    <ScrollViewer x:Name="SettingsScrollViewer"
                  Background="Transparent"
                  MinWidth="440"
                  MinHeight="420"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch">
        <!-- Centering is tied to the window, not the content: the side columns share the space equally, the middle
             column is at most 1000px. Previously the width/position was computed from the width the content asked for,
             and when a section was opened or closed (long text) the whole page shifted. -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1000*" MaxWidth="1000" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="SettingsContent"
                    Grid.Column="1"
                    Spacing="8"
                    Padding="24,0,24,24">

            <!-- Custom Title Bar (Drag Region) -->
            <Grid x:Name="AppTitleBar"
                  Height="36">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="16" Height="16" />
                <TextBlock Text="Ration"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            </Grid>

            <TextBlock Text="{l:Loc En='Settings', Tr='Ayarlar'}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,8,0,0" />

            <!-- The content is in a single panel; scrolling belongs to the ScrollViewer outside it. -->

            <!-- Section: Providers -->
            <TextBlock Text="{l:Loc En='Providers', Tr='Sağlayıcılar'}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,16,0,0" />

            <controls:SettingsExpander x:Name="ClaudeProviderExpander"
                                       Header="Claude Code"
                                       Description="{l:Loc En='Local credentials and usage quota tracking', Tr='Yerel kimlik bilgileri ve kullanım kotası takibi'}"
                                       IsExpanded="false">
                <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{l:Loc En='Provider status', Tr='Sağlayıcı Durumu'}"
                                               Description="{l:Loc En='~/.claude/.credentials.json session', Tr='~/.claude/.credentials.json oturumu'}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <InfoBadge x:Name="ClaudeProviderBadge"
                                           Style="{StaticResource SuccessDotInfoBadgeStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="ClaudeProviderStatus"
                                            Text="{l:Loc En='Checking…', Tr='Denetleniyor…'}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{l:Loc En='Cost scan', Tr='Maliyet Taraması'}"
                                               Description="{l:Loc En='Scan the JSONL session logs under ~/.claude/projects/', Tr='~/.claude/projects/ altındaki JSONL oturum loglarını tara'}">
                            <!-- The real state instead of a disabled toggle that looks switched off: the scan
                                 always runs regardless of settings, the money amount needs pricing.json. -->
                            <StackPanel Spacing="2" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <InfoBadge x:Name="ClaudeCostBadge"
                                               Style="{StaticResource SuccessDotInfoBadgeStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="ClaudeCostStatus"
                                               Text="{l:Loc En='On', Tr='Açık'}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="ClaudeCostReason"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           HorizontalAlignment="Right"
                                           HorizontalTextAlignment="Right"
                                           MaxWidth="240"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </controls:SettingsCard>
                        <!-- Network-free fallback source when the session expires / on 429. Ration does not write to the user's
                             ~/.claude/settings.json file; the user adds the line. -->
                        <controls:SettingsCard Header="{l:Loc En='Claude Code status line', Tr='Claude Code durum satırı'}"
                                               Description="{l:Loc En='While Claude Code is running, quota is read from here without a network request. Add the line to ~/.claude/settings.json; it replaces any existing statusLine.', Tr='Kota, Claude Code açıkken ağ isteği olmadan buradan okunur. Satırı ~/.claude/settings.json dosyasına ekleyin; mevcut bir statusLine varsa onun yerine geçer.'}">
                            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <InfoBadge x:Name="ClaudeStatusLineBadge"
                                               Style="{StaticResource AttentionDotInfoBadgeStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="ClaudeStatusLineStatus"
                                               Text="{l:Loc En='Not connected', Tr='Bağlı değil'}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button x:Name="CopyStatusLineButton"
                                        Content="{l:Loc En='Copy line', Tr='Satırı kopyala'}"
                                        VerticalAlignment="Center" />
                            </StackPanel>
                        </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander x:Name="CodexProviderExpander"
                                       Header="Codex"
                                       Description="{l:Loc En='Local credentials and usage quota tracking', Tr='Yerel kimlik bilgileri ve kullanım kotası takibi'}"
                                       IsExpanded="false">
                <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{l:Loc En='Provider status', Tr='Sağlayıcı Durumu'}"
                                               Description="{l:Loc En='~/.codex/auth.json session', Tr='~/.codex/auth.json oturumu'}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <InfoBadge x:Name="CodexProviderBadge"
                                           Style="{StaticResource SuccessDotInfoBadgeStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="CodexProviderStatus"
                                            Text="{l:Loc En='Checking…', Tr='Denetleniyor…'}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{l:Loc En='Cost scan', Tr='Maliyet Taraması'}"
                                               Description="{l:Loc En='Scan the JSONL session logs under ~/.codex/sessions/', Tr='~/.codex/sessions/ altındaki JSONL oturum loglarını tara'}">
                            <StackPanel Spacing="2" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <InfoBadge x:Name="CodexCostBadge"
                                               Style="{StaticResource SuccessDotInfoBadgeStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="CodexCostStatus"
                                               Text="{l:Loc En='On', Tr='Açık'}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="CodexCostReason"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           HorizontalAlignment="Right"
                                           HorizontalTextAlignment="Right"
                                           MaxWidth="240"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander x:Name="AntigravityProviderExpander"
                                       Header="Antigravity"
                                       Description="{l:Loc En='Quota and token usage are read from the app’s local language server', Tr='Kota ve token kullanımı uygulamanın yerel dil sunucusundan okunur'}"
                                       IsExpanded="false">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="{l:Loc En='Provider status', Tr='Sağlayıcı Durumu'}"
                                           Description="{l:Loc En='Data only updates while Antigravity is running', Tr='Veri yalnızca Antigravity açıkken güncellenir'}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <InfoBadge x:Name="AntigravityProviderBadge"
                                       Style="{StaticResource SuccessDotInfoBadgeStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="AntigravityProviderStatus"
                                       Text="{l:Loc En='Checking…', Tr='Denetleniyor…'}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander x:Name="OpenCodeProviderExpander"
                                       Header="OpenCode"
                                       Description="{l:Loc En='No quota of its own; local usage and free model counter', Tr='Kendi kotası yok; yerel kullanım ve ücretsiz model sayacı'}"
                                       IsExpanded="false">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="{l:Loc En='Provider status', Tr='Sağlayıcı Durumu'}"
                                           Description="{l:Loc En='~/.local/share/opencode/opencode.db local database', Tr='~/.local/share/opencode/opencode.db yerel veritabanı'}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <InfoBadge x:Name="OpenCodeProviderBadge"
                                       Style="{StaticResource SuccessDotInfoBadgeStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="OpenCodeProviderStatus"
                                       Text="{l:Loc En='Checking…', Tr='Denetleniyor…'}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander x:Name="CursorProviderExpander"
                                       Header="Cursor"
                                       Description="{l:Loc En='Plan usage from the Cursor app’s local session', Tr='Cursor uygulamasının yerel oturumundan plan kullanımı'}"
                                       IsExpanded="false">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="{l:Loc En='Provider status', Tr='Sağlayıcı Durumu'}"
                                           Description="{l:Loc En='Session in the Cursor app (state.vscdb); read-only, never refreshed', Tr='Cursor uygulamasındaki oturum (state.vscdb); salt okunur, yenilenmez'}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <InfoBadge x:Name="CursorProviderBadge"
                                       Style="{StaticResource SuccessDotInfoBadgeStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="CursorProviderStatus"
                                       Text="{l:Loc En='Checking…', Tr='Denetleniyor…'}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- Section: General Preferences -->
            <TextBlock Text="{l:Loc En='General', Tr='Genel Tercihler'}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,16,0,0" />

                <controls:SettingsCard Header="{l:Loc En='Refresh interval', Tr='Yenileme Sıklığı'}"
                                        Description="{l:Loc En='How often quotas are checked in the background', Tr='Kotaların arka planda otomatik sorgulanma aralığı'}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72C;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="RefreshIntervalSelection" MinWidth="140">
                        <ComboBoxItem Content="{l:Loc En='5 minutes', Tr='5 dakika'}" Tag="5" />
                        <ComboBoxItem Content="{l:Loc En='15 minutes', Tr='15 dakika'}" Tag="15" />
                        <ComboBoxItem Content="{l:Loc En='30 minutes', Tr='30 dakika'}" Tag="30" />
                        <ComboBoxItem Content="{l:Loc En='1 hour', Tr='1 saat'}" Tag="60" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Header="{l:Loc En='Theme', Tr='Tema'}"
                                       Description="{l:Loc En='Ration’s color theme. Ration restarts itself when it changes.', Tr='Ration’ın renk teması. Değişince Ration kendini yeniden başlatır.'}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ThemeSelection"
                              MinWidth="140"
                              AutomationProperties.Name="{l:Loc En='Theme', Tr='Tema'}">
                        <ComboBoxItem Content="{l:Loc En='System', Tr='Sistem'}" Tag="system" />
                        <ComboBoxItem Content="{l:Loc En='Light', Tr='Açık'}" Tag="light" />
                        <ComboBoxItem Content="{l:Loc En='Dark', Tr='Koyu'}" Tag="dark" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Header="{l:Loc En='Language', Tr='Dil'}"
                                       Description="{l:Loc En='Ration restarts itself when it changes.', Tr='Değişince Ration kendini yeniden başlatır.'}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF2B7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="LanguageSelection"
                              MinWidth="140"
                              AutomationProperties.Name="{l:Loc En='Language', Tr='Dil'}">
                        <ComboBoxItem Content="{l:Loc En='System', Tr='Sistem'}" Tag="system" />
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Türkçe" Tag="tr" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Header="{l:Loc En='Percentages', Tr='Yüzdeler'}"
                                       Description="{l:Loc En='Show what is left or what is used in the panel and the tray tooltip', Tr='Panelde ve tepsi ipucunda kalanı ya da kullanılanı göster'}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="UsageDisplaySelection"
                              MinWidth="140"
                              AutomationProperties.Name="{l:Loc En='Percentages', Tr='Yüzdeler'}">
                        <ComboBoxItem Content="{l:Loc En='Remaining', Tr='Kalan'}" Tag="remaining" />
                        <ComboBoxItem Content="{l:Loc En='Used', Tr='Kullanılan'}" Tag="used" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Header="{l:Loc En='Show in tray', Tr='Tepside göster'}"
                                       Description="{l:Loc En='Which provider’s quota the tray icon shows', Tr='Tepsi ikonunda hangi sağlayıcının kotası gösterilsin'}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE950;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="TrayProviderSelection"
                              SelectedIndex="0"
                              MinWidth="160"
                              AutomationProperties.Name="{l:Loc En='Show in tray', Tr='Tepside göster'}">
                        <ComboBoxItem Content="{l:Loc En='Automatic', Tr='Otomatik'}" Tag="auto" />
                        <ComboBoxItem Content="Claude" Tag="claude" />
                        <ComboBoxItem Content="Codex" Tag="codex" />
                        <ComboBoxItem Content="Antigravity" Tag="antigravity" />
                        <ComboBoxItem Content="OpenCode" Tag="opencode" />
                        <ComboBoxItem Content="Cursor" Tag="cursor" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Header="{l:Loc En='Tray window', Tr='Tepsi penceresi'}"
                                       Description="{l:Loc En='Which quota window the tray icon follows', Tr='Tepsi ikonu hangi kota penceresini izlesin'}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE916;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="TrayWindowSelection"
                              MinWidth="160"
                              AutomationProperties.Name="{l:Loc En='Tray window', Tr='Tepsi penceresi'}">
                        <ComboBoxItem Content="{l:Loc En='Most used', Tr='En çok kullanılan'}" Tag="auto" />
                        <ComboBoxItem Content="{l:Loc En='Session', Tr='Oturum'}" Tag="session" />
                        <ComboBoxItem Content="{l:Loc En='Weekly', Tr='Haftalık'}" Tag="weekly" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Header="{l:Loc En='Status pages', Tr='Durum sayfaları'}"
                                       Description="{l:Loc En='Look at the providers’ public status pages and show a notice when one reports an incident', Tr='Sağlayıcıların herkese açık durum sayfalarına bak, olay bildirirlerse bir uyarı göster'}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE95E;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="StatusChecksToggle"
                                  OnContent="{l:Loc En='On', Tr='Açık'}"
                                  OffContent="{l:Loc En='Off', Tr='Kapalı'}" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="{l:Loc En='Start with Windows', Tr='Windows ile Başlat'}"
                                       Description="{l:Loc En='Run Ration in the background when you sign in', Tr='Oturum açıldığında Ration’ı arka planda otomatik çalıştır'}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="StartupToggle"
                                  OnContent="{l:Loc En='On', Tr='Açık'}"
                                  OffContent="{l:Loc En='Off', Tr='Kapalı'}" />
                </controls:SettingsCard>

                <controls:SettingsExpander x:Name="HotkeyExpander"
                                           Header="{l:Loc En='Global shortcut', Tr='Genel kısayol'}"
                                           IsExpanded="false">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE765;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <ToggleSwitch x:Name="HotkeyToggle"
                                  OnContent="{l:Loc En='On', Tr='Açık'}"
                                  OffContent="{l:Loc En='Off', Tr='Kapalı'}"
                                  AutomationProperties.Name="{l:Loc En='Global shortcut', Tr='Genel kısayol'}" />
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{l:Loc En='Key combination', Tr='Tuş birleşimi'}"
                                               Description="{l:Loc En='Click, then press the new combination. It needs Ctrl, Alt or Win. Esc cancels.', Tr='Tıkla, sonra yeni birleşime bas. Ctrl, Alt veya Win gerekir. Esc iptal eder.'}">
                            <Button x:Name="HotkeyButton"
                                    MinWidth="140"
                                    AutomationProperties.Name="{l:Loc En='Key combination', Tr='Tuş birleşimi'}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander x:Name="NotificationsExpander"
                                           Header="{l:Loc En='Quota notifications', Tr='Kota bildirimleri'}"
                                           Description="{l:Loc En='Notify when session or weekly quota runs low and when it runs out', Tr='Oturum veya haftalık kota azalınca ve dolunca bildir'}"
                                           IsExpanded="false">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xEA8F;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <ToggleSwitch x:Name="NotificationsToggle"
                                  OnContent="{l:Loc En='On', Tr='Açık'}"
                                  OffContent="{l:Loc En='Off', Tr='Kapalı'}" />
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{l:Loc En='Low quota alert', Tr='Azalan kota uyarısı'}"
                                               Description="{l:Loc En='Notify when the remaining quota drops to this level', Tr='Kalan kota bu seviyeye inince bildir'}">
                            <ComboBox x:Name="LowThresholdSelection" MinWidth="140">
                                <ComboBoxItem Content="{l:Loc En='10% left', Tr='%10 kaldı'}" Tag="10" />
                                <ComboBoxItem Content="{l:Loc En='20% left', Tr='%20 kaldı'}" Tag="20" />
                                <ComboBoxItem Content="{l:Loc En='30% left', Tr='%30 kaldı'}" Tag="30" />
                                <ComboBoxItem Content="{l:Loc En='50% left', Tr='%50 kaldı'}" Tag="50" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{l:Loc En='Quota reset', Tr='Kota sıfırlanması'}"
                                               Description="{l:Loc En='Notify when a used-up quota is available again', Tr='Dolan kota yeniden kullanılabilir olunca bildir'}">
                            <ToggleSwitch x:Name="ResetNotifyToggle"
                                          OnContent="{l:Loc En='On', Tr='Açık'}"
                                          OffContent="{l:Loc En='Off', Tr='Kapalı'}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{l:Loc En='Sign-in needed', Tr='Giriş gerekli'}"
                                               Description="{l:Loc En='Notify once when a provider that worked before needs a new sign-in', Tr='Daha önce çalışan bir sağlayıcı yeniden giriş isteyince bir kez bildir'}">
                            <ToggleSwitch x:Name="SignInNotifyToggle"
                                          OnContent="{l:Loc En='On', Tr='Açık'}"
                                          OffContent="{l:Loc En='Off', Tr='Kapalı'}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{l:Loc En='Fast usage', Tr='Hızlı tüketim'}"
                                               Description="{l:Loc En='Notify when usage climbs quickly, for example after a runaway agent', Tr='Kullanım hızla artınca bildir, örneğin kontrolden çıkan bir ajanda'}">
                            <ToggleSwitch x:Name="SurgeNotifyToggle"
                                          OnContent="{l:Loc En='On', Tr='Açık'}"
                                          OffContent="{l:Loc En='Off', Tr='Kapalı'}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{l:Loc En='Fast usage threshold', Tr='Hızlı tüketim eşiği'}"
                                               Description="{l:Loc En='Share of the quota used within 5 minutes', Tr='5 dakikada kullanılan kota payı'}">
                            <ComboBox x:Name="SurgeThresholdSelection" MinWidth="140">
                                <ComboBoxItem Content="{l:Loc En='5% in 5 min', Tr='5 dakikada %5'}" Tag="5" />
                                <ComboBoxItem Content="{l:Loc En='10% in 5 min', Tr='5 dakikada %10'}" Tag="10" />
                                <ComboBoxItem Content="{l:Loc En='20% in 5 min', Tr='5 dakikada %20'}" Tag="20" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Claude Code">
                            <ToggleSwitch x:Name="ClaudeNotifyToggle"
                                          OnContent="{l:Loc En='On', Tr='Açık'}"
                                          OffContent="{l:Loc En='Off', Tr='Kapalı'}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Codex">
                            <ToggleSwitch x:Name="CodexNotifyToggle"
                                          OnContent="{l:Loc En='On', Tr='Açık'}"
                                          OffContent="{l:Loc En='Off', Tr='Kapalı'}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Antigravity">
                            <ToggleSwitch x:Name="AntigravityNotifyToggle"
                                          OnContent="{l:Loc En='On', Tr='Açık'}"
                                          OffContent="{l:Loc En='Off', Tr='Kapalı'}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Cursor">
                            <ToggleSwitch x:Name="CursorNotifyToggle"
                                          OnContent="{l:Loc En='On', Tr='Açık'}"
                                          OffContent="{l:Loc En='Off', Tr='Kapalı'}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsCard x:Name="UpdatesCard">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE895;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{l:Loc En='Updates', Tr='Güncellemeler'}"
                                       Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock x:Name="UpdateStatusText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <HyperlinkButton x:Name="ReleaseNotesLink"
                                             Content="{l:Loc En='Release notes', Tr='Sürüm notları'}"
                                             Padding="0"
                                             Visibility="Collapsed" />
                            <ProgressBar x:Name="UpdateProgress"
                                         Maximum="100"
                                         Visibility="Collapsed" />
                        </StackPanel>
                    </controls:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="InstallUpdateButton"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="{l:Loc En='Download and install update', Tr='Güncellemeyi indir ve kur'}"
                                Visibility="Collapsed" />
                        <Button x:Name="CheckUpdatesButton"
                                Content="{l:Loc En='Check for updates', Tr='Denetle'}" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard Header="{l:Loc En='Pre-release versions', Tr='Ön sürümler'}"
                                       Description="{l:Loc En='Also look for test versions (beta) before they are released. They can be less stable.', Tr='Yayınlanmadan önce test sürümlerini (beta) de ara. Daha az kararlı olabilirler.'}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7C1;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="PrereleaseToggle"
                                  OnContent="{l:Loc En='On', Tr='Açık'}"
                                  OffContent="{l:Loc En='Off', Tr='Kapalı'}" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="{l:Loc En='Diagnostics', Tr='Tanılama'}"
                                       Description="{l:Loc En='Open the log or copy a report with private paths removed', Tr='Günlüğü aç ya da kişisel yolları silinmiş bir rapor kopyala'}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                        <Button x:Name="CopyDiagnosticsButton"
                                Content="{l:Loc En='Copy diagnostics', Tr='Tanılamayı kopyala'}" />
                        <Button x:Name="OpenLogButton"
                                Content="{l:Loc En='Open log', Tr='Günlüğü aç'}" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard Header="{l:Loc En='Data', Tr='Veriler'}"
                                       Description="{l:Loc En='Settings, cached prices and the log live in one folder on this computer', Tr='Ayarlar, önbelleğe alınmış fiyatlar ve günlük bu bilgisayarda tek klasörde durur'}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                        <Button x:Name="OpenDataFolderButton"
                                Content="{l:Loc En='Open data folder', Tr='Veri klasörünü aç'}" />
                        <Button x:Name="ResetSettingsButton"
                                Content="{l:Loc En='Reset settings', Tr='Ayarları sıfırla'}" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard Header="{l:Loc En='Backup', Tr='Yedek'}"
                                       Description="{l:Loc En='Save your preferences to a file or load them from one. Credentials are never included.', Tr='Tercihlerini bir dosyaya kaydet ya da bir dosyadan yükle. Kimlik bilgileri hiçbir zaman dahil edilmez.'}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE74E;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                        <Button x:Name="ExportSettingsButton"
                                Content="{l:Loc En='Export…', Tr='Dışa aktar…'}" />
                        <Button x:Name="ImportSettingsButton"
                                Content="{l:Loc En='Import…', Tr='İçe aktar…'}" />
                    </StackPanel>
                </controls:SettingsCard>

            <!-- Section: About -->
            <TextBlock Text="{l:Loc En='About', Tr='Hakkında'}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,16,0,0" />

            <controls:SettingsCard Header="Ration"
                                   Description="{l:Loc En='AI coding quotas in your Windows tray.', Tr='Windows tepsisinde AI kodlama kotaların.'}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </controls:SettingsCard.HeaderIcon>
                <TextBlock x:Name="VersionText"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </controls:SettingsCard>

            <controls:SettingsCard Header="{l:Loc En='Provider marks', Tr='Sağlayıcı işaretleri'}"
                                   Description="{l:Loc En='Simple Icons (CC0), lobe-icons (MIT), official OpenAI SVG.', Tr='Simple Icons (CC0), lobe-icons (MIT), OpenAI resmi SVG.'}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>

        </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
