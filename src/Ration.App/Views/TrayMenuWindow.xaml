<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Ration.App.Views.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ration Menü">

    <Grid x:Name="RootLayout"
          Background="Transparent"
          Padding="4">
        <Grid.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                             Color="{ThemeResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed"
                             Color="{ThemeResource SubtleFillColorTertiary}" />

            <Style x:Key="TrayMenuButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </Grid.Resources>

        <StackPanel x:Name="MenuStack"
                    Spacing="0">
            <Button x:Name="RefreshButton"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    AutomationProperties.Name="Yenile">
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <Viewbox Width="16"
                             Height="16"
                             Stretch="Uniform">
                        <FontIcon Glyph="&#xE72C;"
                                  FontSize="16"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Viewbox>
                    <TextBlock Text="Yenile"
                               Style="{StaticResource BodyTextBlockStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button x:Name="SettingsButton"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    AutomationProperties.Name="Ayarlar">
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <Viewbox Width="16"
                             Height="16"
                             Stretch="Uniform">
                        <FontIcon Glyph="&#xE713;"
                                  FontSize="16"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Viewbox>
                    <TextBlock Text="Ayarlar"
                               Style="{StaticResource BodyTextBlockStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border x:Name="MenuSeparator"
                    Height="1"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}"
                    Margin="0,4" />

            <Button x:Name="ExitButton"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    AutomationProperties.Name="Çıkış">
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <Viewbox Width="16"
                             Height="16"
                             Stretch="Uniform">
                        <FontIcon Glyph="&#xE7E8;"
                                  FontSize="16"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Viewbox>
                    <TextBlock Text="Çıkış"
                               Style="{StaticResource BodyTextBlockStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
