<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Ration.App.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ration.App.Views"
    Title="Ration">

    <!--
        TASARIM (FLYOUT-DESIGN.md) — bozmadan önce oku.

        1. Sekme şeridi + tek sağlayıcı detayı (macOS CodexBar bilgi mimarisi).
           Kart YOK; bölümler 1px ayırıcıyla bölünür.
        2. Kök Grid ve ScrollViewer SAYDAMDIR: acrylic yalnızca saydam yerde görünür.
        3. SABİT RENK YOK. Fırçalar ThemeResource'tan; ölçer rengi QuotaVisuals.MeterBrush.
        4. Tip rampası: Subtitle (sağlayıcı), BodyStrong (bölüm/pencere), Caption (geri kalan).
        5. Ölçer KALAN kotayı gösterir (tepsi ikonuyla aynı dil), iz belirgin gridir.
        6. Tekrarlayan içerik (pencereler, istatistikler, grafik) DataTemplate + x:Bind;
           kod yalnızca satır listelerini üretir.
    -->

    <Grid x:Name="RootLayout"
          Background="Transparent"
          BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
          BorderThickness="1"
          CornerRadius="{ThemeResource OverlayCornerRadius}"
          Padding="16"
          RowSpacing="12">

        <Grid.Resources>
            <!--  ProgressBar izi varsayılan 1px; ölçerle aynı kalınlıkta dolu iz için ezilir.  -->
            <x:Double x:Key="ProgressBarTrackHeight">6</x:Double>
            <x:Double x:Key="ProgressBarMinHeight">6</x:Double>
            <CornerRadius x:Key="ProgressBarTrackCornerRadius">3</CornerRadius>
            <CornerRadius x:Key="ProgressBarCornerRadius">3</CornerRadius>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Sekme şeridi: ToggleButton'lar koddan üretilir (2-6 sağlayıcı)  -->
        <ScrollViewer x:Name="TabScrollViewer"
                      Grid.Row="0"
                      HorizontalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Disabled">
            <StackPanel x:Name="TabStrip"
                        Orientation="Horizontal"
                        Spacing="0"
                        HorizontalAlignment="Left" />
        </ScrollViewer>

        <!--  Seçili sağlayıcının detayı (taşarsa burası kayar; sekmeler ve alt satır sabit)  -->
        <ScrollViewer x:Name="DetailScrollViewer"
                      Grid.Row="1"
                      Background="Transparent"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <Grid>
                <StackPanel x:Name="WelcomePanel"
                            Spacing="8"
                            Visibility="Collapsed">
                    <TextBlock Text="Henüz bir sağlayıcı bulunamadı."
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Ration'ın veri okuyabilmesi için aşağıdaki sağlayıcılardan birini kurup giriş yapın."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <ItemsControl x:Name="WelcomeProviders" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}"
                                           Margin="0,0,0,6"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="DetailPanel" Spacing="14">

                    <!--  Başlık: solda ad + tazelik, sağda plan  -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="0">
                            <TextBlock x:Name="DetailName"
                                       Text="…"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DetailUpdated"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border x:Name="DetailPlanBadge"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Margin="0,4,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="DetailPlanText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </Grid>


                    <!--  Hata / bayat veri bildirimi. Metin sütunu '*': yoksa sarmalanmaz.  -->
                    <Grid x:Name="DetailError"
                          ColumnSpacing="8"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7BA;"
                                  FontSize="16"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                  VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailErrorTitle"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailErrorDetail"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       MaxLines="3"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!--  Kurulu değil / veri yok: hata sarısı kullanmaz.  -->
                    <Grid x:Name="DetailUnavailable"
                          ColumnSpacing="8"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE946;"
                                  FontSize="16"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailUnavailableTitle"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailUnavailableDetail"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!--  Kota pencereleri  -->
                    <ItemsControl x:Name="WindowList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="14" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:WindowRow">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind GroupHeading}"
                                               Visibility="{x:Bind HeadingVisibility}"
                                               Margin="0,0,0,2"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                    <ProgressBar Value="{x:Bind Remaining}"
                                                 Maximum="100"
                                                 Foreground="{x:Bind MeterBrush}"
                                                 Background="{ThemeResource ControlStrongFillColorDisabledBrush}"
                                                 AutomationProperties.Name="{x:Bind AutomationName}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind RemainingText}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind ResetText}"
                                                   HorizontalAlignment="Right"
                                                   HorizontalTextAlignment="Right"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind PaceText}"
                                               Visibility="{x:Bind PaceVisibility}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  OpenCode: ücretsiz model sayacı (IP bazlı sınır, yalnızca bu bilgisayar)  -->
                    <StackPanel x:Name="FreeUsageSection"
                                Orientation="Horizontal"
                                Spacing="4"
                                Visibility="Collapsed">
                        <TextBlock x:Name="FreeUsageText" Style="{StaticResource CaptionTextBlockStyle}" />
                        <FontIcon Glyph="&#xE946;"
                                  FontSize="12"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Sınır IP adresine göre uygulanır ve yayınlanmaz. Bu sayaç yalnızca bu bilgisayarı sayar." />
                    </StackPanel>

                    <!--  Kullanım ve API karşılığı (yerel log taraması; veri yoksa gizli)  -->
                    <StackPanel x:Name="CostSection" Spacing="10" Visibility="Collapsed">

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="CostTitle"
                                       Text="Kullanım"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <FontIcon x:Name="CostInfoIcon"
                                      Glyph="&#xE946;"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl x:Name="StatList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal"
                                                           MaximumRowsOrColumns="2"
                                                           ItemWidth="168" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:StatItem">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{x:Bind Label}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Value}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Son 30 günün günlük token çubukları  -->
                        <ItemsControl x:Name="DailyChart" Height="44">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:DayBar">
                                    <Grid Height="44"
                                          Width="{x:Bind BarWidth}"
                                          Background="Transparent"
                                          ToolTipService.ToolTip="{x:Bind Tip}">
                                        <!--  Taban: boş günler de eksende yer tutar  -->
                                        <Rectangle Height="2"
                                                   VerticalAlignment="Bottom"
                                                   RadiusX="1"
                                                   RadiusY="1"
                                                   Fill="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                                        <Rectangle Height="{x:Bind BarHeight}"
                                                   VerticalAlignment="Bottom"
                                                   RadiusX="1.5"
                                                   RadiusY="1.5"
                                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Spacing="2">
                            <TextBlock x:Name="ModelLine"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  Alt satır: sağlayıcı bağlantıları + Yenile/Ayarlar. Çıkış sağ tık menüsündedir.  -->
        <Grid Grid.Row="2" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <HyperlinkButton x:Name="DashboardLink"
                                 Padding="6,4"
                                 Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D2;" FontSize="14" />
                        <TextBlock Text="Kullanım paneli" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </HyperlinkButton>
                <HyperlinkButton x:Name="StatusLink"
                                 Padding="6,4"
                                 Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE95E;" FontSize="14" />
                        <TextBlock Text="Durum" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </HyperlinkButton>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button x:Name="RefreshButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="32"
                        Height="32"
                        Padding="0"
                        ToolTipService.ToolTip="Yenile"
                        AutomationProperties.Name="Kotaları Şimdi Yenile">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
                <Button x:Name="SettingsButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="32"
                        Height="32"
                        Padding="0"
                        ToolTipService.ToolTip="Ayarlar"
                        AutomationProperties.Name="Ayarlar">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
