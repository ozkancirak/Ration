<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Ration.App.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Ration.App"
    xmlns:local="using:Ration.App.Views"
    Title="Ration">

    <!--
        DESIGN — read before changing.

        1. Tab strip + single-provider detail (the macOS CodexBar information architecture).
           NO cards; sections are separated by a 1px divider.
        2. The root Grid and the ScrollViewer are TRANSPARENT: acrylic is only visible where it is transparent.
        3. NO FIXED COLORS. Brushes come from ThemeResource; the meter color is QuotaVisuals.MeterBrush.
        4. Type ramp: Subtitle (provider), BodyStrong (section/window), Caption (the rest).
        5. The meter shows the REMAINING quota (the same language as the tray icon), the track is a distinct gray.
        6. Repeating content (windows, statistics, chart) is DataTemplate + x:Bind;
           code only produces the row lists.
    -->

    <Grid x:Name="RootLayout"
          Background="Transparent"
          BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
          BorderThickness="1"
          CornerRadius="{ThemeResource OverlayCornerRadius}"
          Padding="16"
          RowSpacing="12">

        <Grid.Resources>
            <!--  ProgressBar track is 1px by default; overridden for a filled track of the same thickness as the meter.  -->
            <x:Double x:Key="ProgressBarTrackHeight">6</x:Double>
            <x:Double x:Key="ProgressBarMinHeight">6</x:Double>
            <CornerRadius x:Key="ProgressBarTrackCornerRadius">3</CornerRadius>
            <CornerRadius x:Key="ProgressBarCornerRadius">3</CornerRadius>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Tab strip: equal-width columns (like CodexBar). The ToggleButtons and columns
              are produced from code (2-6 providers); icon on top, name below, mini meter at the very bottom.  -->
        <Grid x:Name="TabStrip" Grid.Row="0" ColumnSpacing="4" />

        <!--  Dividers between the fixed parts and the detail: the rows are 12 apart, so the line sits in the middle of the gap  -->
        <Rectangle x:Name="TabDivider"
                   Grid.Row="1"
                   Height="1"
                   Margin="0,-6,0,0"
                   VerticalAlignment="Top"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Rectangle Grid.Row="2"
                   Height="1"
                   Margin="0,-6,0,0"
                   VerticalAlignment="Top"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!--  Detail of the selected provider (this part scrolls if it overflows; the tabs and the bottom row are fixed)  -->
        <ScrollViewer x:Name="DetailScrollViewer"
                      Grid.Row="1"
                      Background="Transparent"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <Grid>
                <StackPanel x:Name="WelcomePanel"
                            Spacing="8"
                            Visibility="Collapsed">
                    <TextBlock Text="{l:Loc En='No provider found yet.', Tr='Henüz bir sağlayıcı bulunamadı.'}"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{l:Loc En='Install and sign in to one of the providers below so Ration can read its data.', Tr='Ration’ın veri okuyabilmesi için aşağıdaki sağlayıcılardan birini kurup giriş yapın.'}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <ItemsControl x:Name="WelcomeProviders" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}"
                                           Margin="0,0,0,6"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="DetailPanel" Spacing="14">

                    <!--  Header: name + freshness on the left, plan on the right  -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="0">
                            <TextBlock x:Name="DetailName"
                                       Text="…"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DetailUpdated"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border x:Name="DetailPlanBadge"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Margin="0,4,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="DetailPlanText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </Grid>


                    <!--  Error / stale data notice: Fluent InfoBar; "Copy" puts the details on the clipboard.  -->
                    <InfoBar x:Name="DetailError"
                             IsOpen="False"
                             IsClosable="False"
                             Severity="Warning">
                        <InfoBar.ActionButton>
                            <Button x:Name="CopyErrorButton"
                                    Content="{l:Loc En='Copy', Tr='Kopyala'}"
                                    HorizontalAlignment="Right" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!--  Not installed / no data: does not use the error yellow.  -->
                    <Grid x:Name="DetailUnavailable"
                          ColumnSpacing="8"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE946;"
                                  FontSize="16"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailUnavailableTitle"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailUnavailableDetail"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!--  Quota windows  -->
                    <ItemsControl x:Name="WindowList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="14" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:WindowRow">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind GroupHeading}"
                                               Visibility="{x:Bind HeadingVisibility}"
                                               Margin="0,0,0,2"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                    <ProgressBar Value="{x:Bind MeterValue}"
                                                 Maximum="100"
                                                 Foreground="{x:Bind MeterBrush}"
                                                 Background="{ThemeResource ControlStrongFillColorDisabledBrush}"
                                                 AutomationProperties.Name="{x:Bind AutomationName}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind PercentText}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold"
                                                   Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind ResetText}"
                                                   ToolTipService.ToolTip="{x:Bind ResetTip}"
                                                   HorizontalAlignment="Right"
                                                   HorizontalTextAlignment="Right"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Typography.NumeralAlignment="Tabular" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind PaceText}"
                                               ToolTipService.ToolTip="{l:Loc En='Compares your usage so far with the share of the window that has passed. Running hot means you are using it faster than time is passing.', Tr='Şu ana kadarki kullanımını, pencerenin geçen süresiyle karşılaştırır. Hızlı gidiyorsun, kotayı zamandan hızlı tükettiğin anlamına gelir.'}"
                                               Visibility="{x:Bind PaceVisibility}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Usage and API equivalent (local log scan; hidden if there is no data)  -->
                    <StackPanel x:Name="CostSection" Spacing="10" Visibility="Collapsed">

                        <Rectangle Height="1"
                                   Margin="0,0,0,2"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="CostTitle"
                                       Text="{l:Loc En='Usage', Tr='Kullanım'}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <FontIcon x:Name="CostInfoIcon"
                                      Glyph="&#xE946;"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl x:Name="StatList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal"
                                                           MaximumRowsOrColumns="2"
                                                           ItemWidth="168" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:StatItem">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{x:Bind Label}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Value}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  OpenCode: free model counter (IP-based limit, this computer only)  -->
                        <StackPanel x:Name="FreeUsageSection"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="FreeUsageText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Typography.NumeralAlignment="Tabular" />
                            <FontIcon Glyph="&#xE946;"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center"
                                      ToolTipService.ToolTip="{l:Loc En='The limit is applied per IP address and is not published. This counter only counts this computer.', Tr='Sınır IP adresine göre uygulanır ve yayınlanmaz. Bu sayaç yalnızca bu bilgisayarı sayar.'}" />
                        </StackPanel>


                        <!--  Daily token bars for the last 30 days  -->
                        <ItemsControl x:Name="DailyChart" Height="44">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:DayBar">
                                    <Grid Height="44"
                                          Width="{x:Bind BarWidth}"
                                          Background="Transparent"
                                          ToolTipService.ToolTip="{x:Bind Tip}">
                                        <!--  Baseline: empty days also hold their place on the axis  -->
                                        <Rectangle Height="2"
                                                   VerticalAlignment="Bottom"
                                                   RadiusX="1"
                                                   RadiusY="1"
                                                   Fill="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                                        <Rectangle Height="{x:Bind BarHeight}"
                                                   VerticalAlignment="Bottom"
                                                   Opacity="{x:Bind BarOpacity}"
                                                   RadiusX="1.5"
                                                   RadiusY="1.5"
                                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid x:Name="DailyChartAxis" Margin="0,-6,0,0">
                            <TextBlock Text="{l:Loc En='30 days ago', Tr='30 gün önce'}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{l:Loc En='Today', Tr='Bugün'}"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>

                        <StackPanel Spacing="2">
                            <TextBlock x:Name="ModelLine"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  Bottom row: provider links + Refresh/Settings. Exit is in the right-click menu.  -->
        <Grid Grid.Row="2" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <HyperlinkButton x:Name="DashboardLink"
                                 Padding="6,4"
                                 Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D2;" FontSize="14" />
                        <TextBlock Text="{l:Loc En='Usage dashboard', Tr='Kullanım paneli'}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </HyperlinkButton>
                <HyperlinkButton x:Name="StatusLink"
                                 Padding="6,4"
                                 Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE95E;" FontSize="14" />
                        <TextBlock Text="{l:Loc En='Status', Tr='Durum'}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </HyperlinkButton>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <!--  Pin: does not close on focus loss, closes when the tray icon is clicked or with Esc.
                      Transparent like the other icon buttons when off; accent color when on (the Windows standard).  -->
                <ToggleButton x:Name="PinButton"
                              Width="32"
                              Height="32"
                              Padding="0"
                              ToolTipService.ToolTip="{l:Loc En='Keep open', Tr='Açık tut'}"
                              AutomationProperties.Name="{l:Loc En='Keep the panel open', Tr='Paneli açık tut'}">
                    <ToggleButton.Resources>
                        <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                        <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                        <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                    </ToggleButton.Resources>
                    <FontIcon Glyph="&#xE718;" FontSize="16" />
                </ToggleButton>
                <Button x:Name="RefreshButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="32"
                        Height="32"
                        Padding="0"
                        KeyboardAcceleratorPlacementMode="Hidden"
                        ToolTipService.ToolTip="{l:Loc En='Refresh (F5)', Tr='Yenile (F5)'}"
                        AutomationProperties.Name="{l:Loc En='Refresh quotas now', Tr='Kotaları Şimdi Yenile'}">
                    <!--  F5 and Ctrl+R click the button; since the button is disabled while refreshing, repeated presses have no effect  -->
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                        <KeyboardAccelerator Key="R" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <!--  A ring spins in place of the icon while refreshing; button size and layout do not change  -->
                    <Grid>
                        <FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" FontSize="16" />
                        <ProgressRing x:Name="RefreshRing"
                                      Width="16"
                                      Height="16"
                                      IsActive="False"
                                      Visibility="Collapsed" />
                    </Grid>
                </Button>
                <Button x:Name="SettingsButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="32"
                        Height="32"
                        Padding="0"
                        ToolTipService.ToolTip="{l:Loc En='Settings', Tr='Ayarlar'}"
                        AutomationProperties.Name="{l:Loc En='Settings', Tr='Ayarlar'}">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
