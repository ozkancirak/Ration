<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Ration.App</RootNamespace>
    <AssemblyName>Ration</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Version>0.2.1</Version>
    <SelfContained>true</SelfContained>
    <!-- Yalnızca TR/EN arayüz dilleri; diğer satellite klasörleri yayına girmez. -->
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
    <!-- Yalnızca framework kütüphaneleri budanır (partial); kendi derlemelerimiz
         bütün kalır. Önbellek/ayar JSON'u reflection'la okunduğu için açık tutulur. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Using Include="Ration.Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <!-- Metapaket yerine yalnızca WinUI: AI/ML/Search/Widgets bileşenleri
         kullanılmıyor ve self-contained yayını ~280 MB'a şişiriyordu. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <!-- SettingsControls 8.2 geçişli olarak eski tek parça metapaketi (1.6) ister;
         varlıklarını dışla ki WinUI 2.x ile çakışmasın. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ration.Core\Ration.Core.csproj" />
    <ProjectReference Include="..\Ration.Platform.Windows\Ration.Platform.Windows.csproj" />
  </ItemGroup>

  <!-- Publish does not carry the generated unpackaged WinUI resource index by
       default. Without it, a self-contained publish fails in InitializeComponent. -->
  <Target Name="CopyGeneratedWinUiResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <GeneratedWinUiResources Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(GeneratedWinUiResources)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(GeneratedWinUiResources.Identity)')" />
  </Target>
</Project>
