<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Kalan.App.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Kalan">

    <!--
        TASARIM NOTLARI — bozmadan önce oku.

        1. Kök Grid ve ScrollViewer'ın ARKA PLANI SAYDAMDIR (Background="Transparent").
           DWM DesktopAcrylicBackdrop yalnızca içeriğin saydam olduğu yerde
           masaüstü duvar kağıdını gösterir.

        2. Kök Grid'in kenarlığı ve köşe yarıçapı YOKTUR. Pencere köşeleri
           DWMWA_WINDOW_CORNER_PREFERENCE ile yuvarlatılır.

        3. SABİT RENK KULLANILMAZ. Tüm renkler ThemeResource'tan gelir; ölçüler
           AccentFillColorDefaultBrush ile kullanıcının Windows accent rengini takip eder.

        4. Sağlayıcı blokları LayerFillColorDefaultBrush kullanır — bu fırça
           Mica/Acrylic ÜSTÜNE oturmak için tasarlanmıştır.

        5. Yazı boyutları WinUI tip rampasıyla verilir:
           BodyStrong (14/600), Body (14/400), Caption (12/400).
    -->

    <Grid x:Name="RootLayout"
          Background="Transparent"
          Padding="12"
          RowSpacing="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Başlık (Yalnızca Yenile butonu, gereksiz [X] kaldırıldı)  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Kalan"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="2">
                <Button x:Name="RefreshButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="32"
                        Height="32"
                        Padding="0"
                        ToolTipService.ToolTip="Şimdi yenile"
                        AutomationProperties.Name="Kotaları Şimdi Yenile">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  Sağlayıcılar  -->
        <ScrollViewer Grid.Row="1"
                      Background="Transparent"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <StackPanel Spacing="6">

                <!--  ============================ Claude  -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Padding="12,10">
                    <StackPanel Spacing="10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE945;"
                                          FontSize="16"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Claude"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center" />
                                <Border x:Name="ClaudePlanBadge"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Padding="6,1"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="ClaudePlanText"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="ClaudeStatusText"
                                       Grid.Column="1"
                                       Text="Bekleniyor…"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <!--  Claude Hata/Giriş Banner'ı (AuthRequired / Error durumunda gösterilir)  -->
                        <Border x:Name="ClaudeErrorPanel"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="10,8"
                                Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="ClaudeErrorIcon"
                                          Glyph="&#xE7BA;"
                                          FontSize="16"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ClaudeErrorTitle"
                                               Text="Oturum Süresi Doldu"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="ClaudeErrorDetail"
                                               Text="Claude Code CLI ile tekrar giriş yapın."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Claude Sayaç Çubukları  -->
                        <StackPanel x:Name="ClaudeMetersPanel" Spacing="10">
                            <!--  5 saatlik  -->
                            <StackPanel Spacing="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="ClaudePrimaryLabelText"
                                               Text="5 saatlik"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <TextBlock x:Name="ClaudeResetText"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="ClaudePrimaryPercentText"
                                                   Text="—"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold"
                                                   MinWidth="36"
                                                   TextAlignment="Right" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar x:Name="ClaudeProgressBar"
                                             Value="0"
                                             Maximum="100"
                                             Height="4"
                                             CornerRadius="2"
                                             AutomationProperties.Name="Claude 5 saatlik kota" />
                            </StackPanel>

                            <!--  Haftalık  -->
                            <StackPanel Spacing="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Haftalık"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <TextBlock x:Name="ClaudeWeeklyResetText"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="ClaudeWeeklyPercentText"
                                                   Text="—"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold"
                                                   MinWidth="36"
                                                   TextAlignment="Right" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar x:Name="ClaudeWeeklyProgressBar"
                                             Value="0"
                                             Maximum="100"
                                             Height="4"
                                             CornerRadius="2"
                                             AutomationProperties.Name="Claude haftalık kota" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  ============================ Codex  -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Padding="12,10">
                    <StackPanel Spacing="10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE943;"
                                          FontSize="16"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Codex"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center" />
                                <Border x:Name="CodexPlanBadge"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Padding="6,1"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="CodexPlanText"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="CodexStatusText"
                                       Grid.Column="1"
                                       Text=""
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <!--  Codex Hata/Giriş Banner'ı (AuthRequired / Error durumunda gösterilir)  -->
                        <Border x:Name="CodexErrorPanel"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="10,8"
                                Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="CodexErrorIcon"
                                          Glyph="&#xE7BA;"
                                          FontSize="16"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="CodexErrorTitle"
                                               Text="Oturum Süresi Doldu"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="CodexErrorDetail"
                                               Text="Codex CLI ile tekrar giriş yapın."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Codex Sayaç Çubukları  -->
                        <StackPanel x:Name="CodexMetersPanel" Spacing="10">
                            <StackPanel Spacing="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="CodexPrimaryLabelText"
                                               Text="5 saatlik"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <TextBlock x:Name="CodexPrimaryResetText"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="CodexPrimaryPercentText"
                                                   Text="—"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold"
                                                   MinWidth="36"
                                                   TextAlignment="Right" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar x:Name="CodexProgressBar"
                                             Value="0"
                                             Maximum="100"
                                             Height="4"
                                             CornerRadius="2"
                                             AutomationProperties.Name="Codex 5 saatlik kota" />
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="CodexSecondaryLabelText"
                                               Text="Haftalık"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <TextBlock x:Name="CodexSecondaryResetText"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="CodexSecondaryPercentText"
                                                   Text="—"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold"
                                                   MinWidth="36"
                                                   TextAlignment="Right" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar x:Name="CodexSecondaryProgressBar"
                                             Value="0"
                                             Maximum="100"
                                             Height="4"
                                             CornerRadius="2"
                                             AutomationProperties.Name="Codex haftalık kota" />
                            </StackPanel>

                            <!--  Model bazlı ek kota (ör. gpt-reserve)  -->
                            <StackPanel x:Name="CodexReserveStackPanel"
                                        Spacing="5"
                                        Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="CodexReserveLabelText"
                                               Text="Ek kota"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <TextBlock x:Name="CodexReserveResetText"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="CodexReservePercentText"
                                                   Text="—"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold"
                                                   MinWidth="36"
                                                   TextAlignment="Right" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar x:Name="CodexReserveProgressBar"
                                             Value="0"
                                             Maximum="100"
                                             Height="4"
                                             CornerRadius="2"
                                             AutomationProperties.Name="Codex ek kota" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  ============================ Henüz bağlanmamış sağlayıcılar  -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Padding="12,10">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE710;"
                                      FontSize="16"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Diğer sağlayıcılar"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Gemini, Copilot, Cursor ve Antigravity henüz bağlanmadı."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  Alt bilgi  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE823;"
                          FontSize="12"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="LastUpdatedText"
                           Text="Henüz güncellenmedi"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="Esc"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
