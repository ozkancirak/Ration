<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Kalan.App.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Kalan">

    <!--
        TASARIM (FLYOUT-DESIGN.md) — bozmadan önce oku.

        1. Sekme şeridi + tek sağlayıcı detayı. Kart YOK: Border + BorderThickness
           kullanılmaz (plan rozetindeki çerçevesiz hap hariç — o arka plan hapıdır).
        2. Kök Grid ve ScrollViewer SAYDAMDIR (Background="Transparent").
           DWM DesktopAcrylicBackdrop yalnızca saydam yerde duvar kağıdını gösterir.
        3. SABİT RENK YOK. Fırçalar ThemeResource'tan; ölçer rengi QuotaVisuals.MeterBrush
           (accent / %75+ caution / %90+ critical).
        4. Tip rampası: Subtitle (sağlayıcı adı), BodyStrong (pencere adı + Maliyet),
           Caption (geri kalan her şey). Ham FontSize yasak.
        5. Ölçerler 3px hairline, iz SubtleFillColorTertiaryBrush. Sekme mini ölçerleri 2px.
    -->

    <Grid x:Name="RootLayout"
          Background="Transparent"
          Padding="16"
          RowSpacing="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Sekme şeridi: ToggleButton'lar koddan üretilir (2-6 sağlayıcı)  -->
        <ScrollViewer x:Name="TabScrollViewer"
                      Grid.Row="0"
                      HorizontalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Disabled">
            <StackPanel x:Name="TabStrip"
                        Orientation="Horizontal"
                        Spacing="0"
                        HorizontalAlignment="Left" />
        </ScrollViewer>

        <!--  Seçili sağlayıcının detayı (taşarsa burası kayar; sekmeler ve eylemler sabit)  -->
        <ScrollViewer x:Name="DetailScrollViewer"
                      Grid.Row="1"
                      Background="Transparent"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <Grid>
                <StackPanel x:Name="WelcomePanel"
                            Spacing="8"
                            Visibility="Collapsed">
                    <TextBlock Text="Henüz bir sağlayıcı bulunamadı."
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Kalan'ın veri okuyabilmesi için aşağıdaki sağlayıcılardan birini kurup giriş yapın."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="WelcomeProvidersPanel"
                                Spacing="6"
                                Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel x:Name="DetailPanel" Spacing="16">

                <!--  Sağlayıcı adı + plan + tazelik  -->
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <ContentControl x:Name="DetailIconHost"
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center" />
                        <TextBlock x:Name="DetailName"
                                   Text="…"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Border x:Name="DetailPlanBadge"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <TextBlock x:Name="DetailPlanText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="DetailUpdated"
                               Text=""
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!--  Hata/giriş bildirimi (çerçevesiz; yalnızca AuthRequired/Error iken)  -->
                <!--  Grid: metin sütunu '*' olmalı, yoksa TextBlock sarmalanmaz.  -->
                <Grid x:Name="DetailError"
                      ColumnSpacing="8"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE7BA;"
                              FontSize="16"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}"
                              VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="DetailErrorTitle"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailErrorDetail"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxLines="3"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!--  Kurulu değil / veri yok bildirimi: hata kırmızısı kullanmaz.  -->
                <Grid x:Name="DetailUnavailable"
                      ColumnSpacing="8"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE946;"
                              FontSize="16"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="DetailUnavailableTitle"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailUnavailableDetail"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!--  Kota pencereleri: koddan üretilir (etiket + 3px ölçer + yüzde/süre + tempo)  -->
                <StackPanel x:Name="DetailWindows" Spacing="14" />
                <TextBlock x:Name="MostUsedModelText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <!--  Maliyet özeti (yerel JSONL taraması; veri yoksa gizli)  -->
                <StackPanel x:Name="CostSection" Spacing="4" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="CostTitle"
                                       Text="API karşılığı"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <FontIcon x:Name="CostInfoIcon"
                                      Glyph="&#xE946;"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="CostAmount"
                                   Grid.Column="1"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock x:Name="CostSummary"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  Eylem satırı: ikon düğmeleri; Çıkış sağ tık menüsündedir.  -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="4">
            <Button x:Name="RefreshButton"
                    Style="{StaticResource SubtleButtonStyle}"
                    Width="32"
                    Height="32"
                    MinWidth="32"
                    MinHeight="32"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTipService.ToolTip="Yenile"
                    Content="&#xE72C;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="16"
                    AutomationProperties.Name="Kotaları Şimdi Yenile" />
            <Button x:Name="SettingsButton"
                    Style="{StaticResource SubtleButtonStyle}"
                    Width="32"
                    Height="32"
                    MinWidth="32"
                    MinHeight="32"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTipService.ToolTip="Ayarlar"
                    Content="&#xE713;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="16"
                    AutomationProperties.Name="Ayarlar" />
        </StackPanel>
    </Grid>
</Window>
