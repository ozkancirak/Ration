<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Kalan.App.Views.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Kalan Menü">

    <!--
        Native tepsi menüsü: WinForms ContextMenuStrip yerine WinUI penceresi.
        Satır 32px, solda 16px FontIcon, Body tip rampası. Renkler ThemeResource'tan
        gelir (hover/seçili dahil); akrilik ve metin tema değişiminde kendiliğinden uyar.
        Kök saydamdır, pencere köşesi DWM ile yuvarlatılır (kart çerçevesi yok).
    -->

    <Grid x:Name="RootLayout"
          Background="Transparent"
          Padding="4">
        <ListView x:Name="MenuList"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Window>
