<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Kalan.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Title="Ayarlar — Kalan">

    <ScrollViewer x:Name="SettingsScrollViewer"
                  Background="Transparent"
                  MinWidth="440"
                  MinHeight="420"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Center">
        <StackPanel x:Name="SettingsContent"
                    Spacing="16"
                    MaxWidth="600"
                    HorizontalAlignment="Center"
                    Padding="24,0,24,24">

            <!-- Özel Başlık Çubuğu (Drag Region) -->
            <Grid x:Name="AppTitleBar"
                  Height="36">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE713;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Kalan"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            </Grid>

            <TextBlock Text="Ayarlar"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,8,0,0" />

            <!-- İçerik tek panel içinde; kaydırma bunun dışındaki ScrollViewer'a aittir. -->

                <!-- Bölüm: Sağlayıcılar -->
                <TextBlock Text="Sağlayıcılar"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,4,0,0" />

                <controls:SettingsExpander Header="Claude Code"
                                           Description="Yerel kimlik bilgileri ve kullanım kotası takibi"
                                           IsExpanded="true">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE945;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <!-- 6a: Devre dışı toggle yerine InfoBadge ve "Bağlı" durumu -->
                        <controls:SettingsCard Header="Sağlayıcı Durumu"
                                               Description="~/.claude/.credentials.json oturumu">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <InfoBadge Style="{StaticResource SuccessDotInfoBadgeStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="Bağlı"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Maliyet Taraması"
                                               Description="~/.claude/projects/ altındaki JSONL oturum loglarını tara">
                            <!-- Kapalı gibi duran pasif toggle yerine gerçek durum: tarama
                                 ayarsız her zaman çalışır, para tutarı pricing.json ister. -->
                            <StackPanel Spacing="2" MinWidth="180">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <InfoBadge x:Name="ClaudeCostBadge"
                                               Style="{StaticResource SuccessDotInfoBadgeStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="ClaudeCostStatus"
                                               Text="Açık"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="ClaudeCostReason"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="Codex"
                                           Description="Yerel kimlik bilgileri ve kullanım kotası takibi"
                                           IsExpanded="true">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE943;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <!-- 6a: Devre dışı toggle yerine InfoBadge ve "Bağlı" durumu -->
                        <controls:SettingsCard Header="Sağlayıcı Durumu"
                                               Description="~/.codex/auth.json oturumu">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <InfoBadge Style="{StaticResource SuccessDotInfoBadgeStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="Bağlı"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Maliyet Taraması"
                                               Description="~/.codex/sessions/ altındaki JSONL oturum loglarını tara">
                            <StackPanel Spacing="2" MinWidth="180">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <InfoBadge x:Name="CodexCostBadge"
                                               Style="{StaticResource SuccessDotInfoBadgeStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="CodexCostStatus"
                                               Text="Açık"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="CodexCostReason"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!-- Bölüm: Genel Tercihler -->
                <TextBlock Text="Genel Tercihler"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,8,0,0" />

                <controls:SettingsCard Header="Yenileme Sıklığı"
                                       Description="Kotaların arka planda otomatik sorgulanma aralığı">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72C;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox SelectedIndex="0" MinWidth="140">
                        <ComboBoxItem Content="5 dakika" />
                        <ComboBoxItem Content="15 dakika" />
                        <ComboBoxItem Content="30 dakika" />
                        <ComboBoxItem Content="1 saat" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Header="Windows ile Başlat"
                                       Description="Oturum açıldığında Kalan'ı arka planda otomatik çalıştır">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="false" OnContent="Açık" OffContent="Kapalı" />
                </controls:SettingsCard>

                <!-- Bölüm: Hakkında -->
                <TextBlock Text="Hakkında"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,8,0,0" />

                <controls:SettingsCard Header="Kalan"
                                       Description="Windows 11 Native System Tray Quota Tracker">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </controls:SettingsCard.HeaderIcon>
                    <TextBlock Text="Sürüm 0.2"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" />
                </controls:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Window>
